{
  "rules": {
    // Members can read and edit any document, but only its creator can delete it
    // (and nobody can change who the creator is).
    "documents": {
      ".read": "auth != null",
      ".indexOn": ["updatedAt"],
      "$docId": {
        // Create it as yourself, with your real email, or delete it if it's yours.
        ".write": "auth != null && (data.exists() ? !newData.exists() && data.child('ownerId').val() === auth.uid : newData.child('ownerId').val() === auth.uid && newData.child('ownerEmail').val() === auth.token.email)",
        // Members can change these on an existing document, but not remove them.
        "title": { ".write": "auth != null && data.parent().exists() && newData.exists()" },
        "updatedAt": { ".write": "auth != null && data.parent().exists() && newData.exists()" },
        "content": { ".write": "auth != null && data.parent().exists() && newData.exists()" }
      }
    },
    "updates": {
      "$docId": {
        ".read": "auth != null",
        // Only the document's owner can clear the whole list; single edits can be added or compacted by anyone.
        ".write": "auth != null && !newData.exists() && root.child('documents/' + $docId + '/ownerId').val() === auth.uid",
        "$updateId": { ".write": "auth != null" }
      }
    },
    "awareness": {
      "$docId": {
        ".read": "auth != null",
        // Each cursor belongs to whoever wrote it first, and carries their real email.
        "$clientId": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || (newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email))"
        }
      }
    }
  }
}
